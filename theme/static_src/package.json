{
  "name": "theme",
  "version": "4.6.0",
  "description": "",
  "scripts": {
    "start": "npm run dev",
    "build": "npm run build:clean && npm run build:sass && npm run build:tailwind",
    "build:clean": "rimraf ../static/css/dist",
    "build:sass": "sass --load-path=node_modules --no-source-map --quiet-deps src/carbon.scss src/carbon.css --style=compressed",
    "build:tailwind": "cross-env NODE_ENV=production postcss ./src/styles.css -o ../static/css/dist/styles.css --minify",
    "dev": "npm run build:sass && run-p dev:sass dev:tailwind",
    "dev:sass": "sass --load-path=node_modules --no-source-map --quiet-deps src/carbon.scss src/carbon.css --watch",
    "dev:tailwind": "cross-env NODE_ENV=development postcss ./src/styles.css -o ../static/css/dist/styles.css --watch"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@carbon/styles": "^1.119.0",
    "@tailwindcss/postcss": "^4.3.3",
    "cross-env": "^10.1.0",
    "npm-run-all2": "^9.0.4",
    "postcss": "^8.5.30",
    "postcss-cli": "^12.0.0",
    "postcss-nested": "^8.0.1",
    "postcss-simple-vars": "^7.0.1",
    "rimraf": "^6.1.3",
    "sass": "^1.108.1",
    "tailwindcss": "^4.3.3"
  }
}
